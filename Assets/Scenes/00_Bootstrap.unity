  excellentTitle: "K\u1EBFt th\xFAc t\u1ED1t"
  goodTitle: "K\u1EBFt th\xFAc kh\xE1"
  averageTitle: "K\u1EBFt th\xFAc trung b\xECnh"
  academicFailTitle: "B\xE3n \u0111\xE3 th\u1EA5t b\u1EA1i"
  dropoutTitle: "B\u1EA1n b\u1ECB bu\u1ED9c th\xF4i h\u1ECDc"
  stressTitle: "Ki\u1EC7t s\u1EE9c!"
  badHabitTitle: "B\u1EA1n \u0111\xE3 sa ng\xE3"
  useLetterForExcellent: 1
  excellentLetterTitleOverride: "B\u1EA1n ho\xE0n th\xE0nh xu\u1EA5t s\u1EAFc k\u1EF3
    h\u1ECDc"
  excellentLetterBodyOverride: "B\u1EA1n \u0111\xE3 c\xF3 m\u1ED9t k\u1EF3 h\u1ECDc
    xu\u1EA5t s\u1EAFc, x\u1EE9ng danh sinh vi\xEAn gi\u1ECFi."
  excellentLetterCloseText: "\u0110\u01B0\u1EE3c"
  useLetterForGood: 1
  goodLetterTitleOverride: 
  goodLetterBodyOverride: "B\u1EA1n \u0111\xE3 c\xF3 m\u1ED9t k\u1EF3 h\u1ECDc kh\xE1,
    c\u1ED1 g\u1EAFng gi\u1EEF phong \u0111\u1ED9 n\xE0y."
  goodLetterCloseText: "\u0110\u01B0\u1EE3c"
  useLetterForAverage: 1
  averageLetterTitleOverride: 
  averageLetterBodyOverride: "B\u1EA1n \u0111\xE3 qua k\u1EF3 h\u1ECDc v\u1EDBi k\u1EBFt
    qu\u1EA3 trung b\xECnh, c\u1EA7n c\u1EA3i thi\u1EC7n th\xEAm."
  averageLetterCloseText: "\u0110\u01B0\u1EE3c"
  useLetterForDropout: 1
  dropoutLetterTitleOverride: "B\u1EA1n b\u1ECB bu\u1ED9c th\xF4i h\u1ECDc "
  dropoutLetterBodyOverride: "V\xEC ngh\u1EC9 qu\xE1 nhi\u1EC1u trong th\u1EDDi gian
    \u0111i h\u1ECDc. B\u1EA1n \u0111\xE3 b\u1ECB th\u1EA7y hi\u1EC7u tr\u01B0\u1EDFng
    cho th\xF4i h\u1ECDc. B\xE2y gi\u1EDD b\u1EA1n c\u1EA7n r\u1EDDi th\xE0nh kh\u1ECFi
    tr\u01B0\u1EDDng v\xE0 tr\u1EDD v\u1EC1 nh\xE0. "
  dropoutLetterCloseText: "R\u1EDDi kh\u1ECFi tr\u01B0\u1EDDng"
  useLetterForStress: 1
  stressLetterTitleOverride: 
  stressLetterBodyOverride: "\xC1p l\u1EF1c qu\xE1 l\u1EDBn khi\u1EBFn b\u1EA1n suy
    s\u1EE5p. B\u1EA1n quy\u1EBFt \u0111\u1ECBnh b\u1ECF h\u1ECDc v\xE0 tr\u1EDD
    th\xE0nh \xF4ng vua t\xE0i x\u1EC9u"
  stressLetterCloseText: ....
  endingCreditsDelayRealtime: 0.5
  disableAutoTickOnEnding: 1
