    options:
    - "R\xE0ng bu\u1ED9c tham chi\u1EBFu gi\u1EEFa b\u1EA3ng"
    - "T\u0103ng t\u1ED1c sort RAM"
    - "M\xE3 h\xF3a c\u1ED9t"
    - "T\u1EA1o index t\u1EF1 \u0111\u1ED9ng m\u1ECDi tr\u01B0\u1EDDng h\u1EE3p"
