      nextNode: 
      rewardItem: {fileID: 0}
      quest: {fileID: 0}
      nextNodeOnSuccess: 
      nextNodeOnFail: 
  - text: "B\u1EA1n \u0111\xE3 c\xF3 b\u1EA1n b\xE8 trong l\u1EDBp ch\u01B0a? L\xE0m
      b\u1EA1n v\u1EDBi m\xECnh nh\xE9!"
