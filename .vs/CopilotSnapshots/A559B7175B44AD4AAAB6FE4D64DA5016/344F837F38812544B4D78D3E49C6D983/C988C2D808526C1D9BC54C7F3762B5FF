using UnityEngine;

public class QuestGiverNPC : InteractableBase
{
    [SerializeField] private QuestData quest;

    public override void Interact()
    {
        if (quest == null)
        {
            return;
        }

        if (QuestManager.Instance == null)
        {
            Debug.LogWarning("QuestGiverNPC: QuestManager not found in scene.");
            return;
        }

        if (!QuestManager.Instance.IsAccepted(quest))
        {
            QuestManager.Instance.AcceptQuest(quest);
        }

        // Optionally: open dialogue or just accept quest
        if (EventManager.Instance != null)
        {
            EventManager.Instance.NotifyStatChanged();
        }
    }

    public override string GetInteractText()
    {
        if (quest == null) return string.Empty;
        return "Press E";
    }
}
